{
  "name": "maestro-tools",
  "version": "0.4.0",
  "private": true,
  "description": "Standalone CNC/CAM tools for SCM Maestro: generate and check .pgmx programs",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "dist:dir": "npm run build && electron-builder --win dir --x64",
    "serve": "npm run build && node dist/server/server.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "three": "^0.169.0"
  },
  "author": "Shane (Central ITM)",
  "build": {
    "appId": "nz.co.centralitm.maestrotools",
    "productName": "Maestro Tools",
    "copyright": "Central ITM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/**/*.map",
      "!dist/server/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Maestro Tools",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "asar": true
  }
}
