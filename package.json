{
  "name": "maestro-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone CNC/CAM tools for SCM Maestro: generate and check .pgmx programs",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
